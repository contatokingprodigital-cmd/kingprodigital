rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'contatokingprodigital@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidPartnerCompany(data) {
      return data.keys().hasAll(['name', 'logoUrl', 'logoBg', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'name',
          'segment',
          'logoUrl',
          'logoBg',
          'whatsappUrl',
          'instagramUrl',
          'addressUrl',
          'addressLabel',
          'ownerId',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidOptionalString(data, 'segment', 120)
        && data.logoUrl is string && data.logoUrl.size() >= 1 && data.logoUrl.size() <= 500000
        && data.logoBg is string && data.logoBg in ['dark', 'light']
        && isValidOptionalString(data, 'whatsappUrl', 500)
        && isValidOptionalString(data, 'instagramUrl', 500)
        && isValidOptionalString(data, 'addressUrl', 1000)
        && isValidOptionalString(data, 'addressLabel', 180)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartnerStats(data) {
      return data.keys().hasAll(['whatsappClicks', 'instagramClicks', 'addressClicks', 'updatedAt'])
        && data.keys().hasOnly(['whatsappClicks', 'instagramClicks', 'addressClicks', 'updatedAt'])
        && data.whatsappClicks is int && data.whatsappClicks >= 0
        && data.instagramClicks is int && data.instagramClicks >= 0
        && data.addressClicks is int && data.addressClicks >= 0
        && data.updatedAt is timestamp;
    }

    function isSingleClickIncrement() {
      return (
        incoming().diff(existing()).affectedKeys().hasOnly(['whatsappClicks', 'updatedAt'])
        && incoming().whatsappClicks == existing().whatsappClicks + 1
      ) || (
        incoming().diff(existing()).affectedKeys().hasOnly(['instagramClicks', 'updatedAt'])
        && incoming().instagramClicks == existing().instagramClicks + 1
      ) || (
        incoming().diff(existing()).affectedKeys().hasOnly(['addressClicks', 'updatedAt'])
        && incoming().addressClicks == existing().addressClicks + 1
      );
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /partner_companies/{companyId} {
      allow get: if isValidId(companyId);
      allow list: if true;

      allow create: if isOwnerAdmin()
        && isValidId(companyId)
        && isValidPartnerCompany(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwnerAdmin()
        && isValidId(companyId)
        && isValidPartnerCompany(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'segment',
          'logoUrl',
          'logoBg',
          'whatsappUrl',
          'instagramUrl',
          'addressUrl',
          'addressLabel',
          'updatedAt'
        ]);

      allow delete: if isOwnerAdmin() && isValidId(companyId);
    }

    match /partner_company_stats/{companyId} {
      allow get: if isOwnerAdmin() && isValidId(companyId);
      allow list: if isOwnerAdmin() && resource.data.whatsappClicks is int;

      allow create: if isValidId(companyId)
        && isValidPartnerStats(incoming())
        && incoming().updatedAt == request.time
        && incoming().whatsappClicks <= 1
        && incoming().instagramClicks <= 1
        && incoming().addressClicks <= 1
        && (incoming().whatsappClicks + incoming().instagramClicks + incoming().addressClicks) == 1
        && exists(/databases/$(database)/documents/partner_companies/$(companyId));

      allow update: if isValidId(companyId)
        && isValidPartnerStats(incoming())
        && incoming().updatedAt == request.time
        && (isOwnerAdmin() || isSingleClickIncrement());

      allow delete: if isOwnerAdmin() && isValidId(companyId);
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }
  }
}
